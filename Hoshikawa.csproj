<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The test projects and godot-e2e's client build on their own; the SDK would otherwise glob them into the game. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="addons/gdunit_e2e/csharp/**" />
  </ItemGroup>
</Project>
